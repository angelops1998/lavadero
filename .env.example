# Plantilla de configuración. Copiala a .env y completá los valores.
#   cp .env.example .env  &&  nano .env
# NUNCA subas el .env real al repo (ya está en .gitignore).

# --- Base de datos ---
# Producción: Postgres del sistema con usuario y contraseña propios.
#   Formato: postgresql://USUARIO:PASSWORD@127.0.0.1:5432/lavanderia
# Desarrollo rápido (sin Postgres): sqlite:///./dev.db
DATABASE_URL=postgresql://lavanderia:CAMBIAR_PASSWORD@127.0.0.1:5432/lavanderia

# --- Clave de firma (JWT + CSRF) ---
# Generá una NUEVA para producción:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_NUEVA_DE_128_HEX

# --- JWT ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Seguridad de cookies ---
# En producción DEBE ser true (la app corre detrás de HTTPS/nginx).
HTTPS_ONLY=false

# --- Negocio ---
# Nombre que aparece en el sitio y en el mensaje de WhatsApp.
NEGOCIO_NOMBRE=Lavandería
# Código de país para armar el link de WhatsApp (Bolivia = 591, Argentina = 54).
CODIGO_PAIS=591
# URL pública base para el link de consulta que se manda por WhatsApp.
BASE_URL=http://localhost:8000
# Días que un pedido puede estar "listo" antes de avisar que nadie lo retira.
DIAS_ALERTA_RETIRO=3
# Días listo sin retirar a partir de los cuales la ropa se marca como abandonada
# en /inventario/custodia (el aviso del tablero sigue usando DIAS_ALERTA_RETIRO).
DIAS_ABANDONO=30
# Zona horaria del negocio (nombre IANA). La base guarda en UTC y se muestra
# en esta zona: sin esto, un pedido de las 23:00 aparecería con la fecha del
# día siguiente. Ej: America/La_Paz, America/Argentina/Buenos_Aires.
TIMEZONE=America/La_Paz

# Ancho del papel de la impresora térmica en mm (58 u 80, los dos estándares).
# Para probar el otro ancho sin tocar esto: /ordenes/{id}/ticket?ancho=80
TICKET_ANCHO_MM=58
